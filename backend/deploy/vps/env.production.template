# MintoBill production settings: /var/www/mintobill/shared/.env
# (root:mintobill 0640). setup-server.sh fills in the DATABASE_*, JWT and MASTER keys with
# generated secrets. Lines marked REQUIRED must be filled in by the owner
# before posd can start (production refuses to start without them).
# Every variable: docs/PHASE1_DESIGN.md §6 and backend/internal/config.

APP_ENV=production
BASE_DOMAIN=mintobill.com
PLATFORM_NAME=MintoBill
PUBLIC_SCHEME=https
HTTP_ADDR=127.0.0.1:8090
METRICS_ADDR=127.0.0.1:9095
TRUSTED_PROXY_CIDRS=127.0.0.1/32
LOG_LEVEL=info
LOG_FORMAT=json
# Turn on only after the go-live checklist (OPERATIONS §7).
HSTS_ENABLED=false

# Database: the 18/mintobill cluster on 127.0.0.1:5433, TLS verified
# against the MintoBill internal CA. Small pools for a 4 GB shared VPS.
DATABASE_URL="@DATABASE_URL@"
DATABASE_JOBS_URL="@DATABASE_JOBS_URL@"
DATABASE_MIGRATOR_URL="@DATABASE_MIGRATOR_URL@"
DB_POOL_MAX=10
DB_POOL_MIN=1

JWT_KEYS="@JWT_KEYS@"
PLATFORM_JWT_KEYS="@PLATFORM_JWT_KEYS@"
MASTER_KEYS="@MASTER_KEYS@"

# File storage (REQUIRED): an S3-compatible bucket over https, e.g.
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com,
# S3_REGION=auto.
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# Platform email (REQUIRED): invites, password resets, receipts.
# Amazon SES ap-south-1, Brevo, Zoho, ... over STARTTLS (587) or TLS (465).
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@mintobill.com
# Where landing-page contact and demo requests are emailed (optional).
CONTACT_EMAIL=

# Payments: none until Razorpay keys exist (BILLING_DESIGN).
BILLING_PROVIDER=none

# Encrypted per-shop exports (OPERATIONS §6.2): off until both are set.
# The matching age identity (private key) stays offline, for posctl restore.
EXPORT_AGE_RECIPIENT=
EXPORT_MANIFEST_KEY=
