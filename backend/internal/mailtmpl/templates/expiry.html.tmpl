{{define "body"}}
<p style="margin:0 0 12px;">Hello {{.Name}},</p>
<p style="margin:0 0 12px;">Stock to act on at {{.BusinessName}} ({{.Date}}):</p>
<ul style="margin:0 0 12px;padding-left:20px;">
<li>Expired on the shelf: <strong>{{.Expired}}</strong> units</li>
<li>Expiring within {{.WindowDays}} days: <strong>{{.Expiring}}</strong> units</li>
<li>Quarantined: {{.Quarantined}} units</li>
<li>Recalled: {{.Recalled}} units</li>
</ul>
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;font-size:13px;border-collapse:collapse;margin:0 0 12px;">
<tr><th align="left" style="padding:4px 8px 4px 0;border-bottom:1px solid #e4e4e7;">Item</th><th align="left" style="padding:4px 8px;border-bottom:1px solid #e4e4e7;">Batch</th><th align="left" style="padding:4px 8px;border-bottom:1px solid #e4e4e7;">Store</th><th align="right" style="padding:4px 0 4px 8px;border-bottom:1px solid #e4e4e7;">Qty</th></tr>
{{range .Items}}<tr><td style="padding:4px 8px 4px 0;">{{.Name}} <span style="color:#71717a;">{{.Section}}</span></td><td style="padding:4px 8px;">{{.Batch}}{{if .Expiry}} <span style="color:#71717a;">exp {{.Expiry}}</span>{{end}}</td><td style="padding:4px 8px;">{{.Store}}</td><td align="right" style="padding:4px 0 4px 8px;">{{.Qty}}</td></tr>
{{end}}</table>
{{if .More}}<p style="margin:0 0 12px;">… and {{.More}} more.</p>{{end}}
{{if .Link}}<p style="margin:0 0 12px;"><a href="{{.Link}}" style="display:inline-block;background:#2563eb;color:#ffffff;padding:10px 16px;border-radius:6px;text-decoration:none;">Expiry report</a></p>{{end}}
{{end}}
