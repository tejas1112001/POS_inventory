{{define "body"}}
<h1 style="font-size:20px;margin:0 0 16px;">{{.Heading}}</h1>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 16px;font-size:14px;">
<tr><td style="padding:2px 12px 2px 0;color:#52525b;">Tenant</td><td style="padding:2px 0;">{{.TenantName}} ({{.Slug}})</td></tr>
<tr><td style="padding:2px 12px 2px 0;color:#52525b;">Setting</td><td style="padding:2px 0;">{{.Label}}</td></tr>
<tr><td style="padding:2px 12px 2px 0;color:#52525b;">Value</td><td style="padding:2px 0;">{{.Value}}</td></tr>
<tr><td style="padding:2px 12px 2px 0;color:#52525b;">Reason</td><td style="padding:2px 0;">{{.Reason}}</td></tr>
<tr><td style="padding:2px 12px 2px 0;color:#52525b;">Ends</td><td style="padding:2px 0;">{{.Expires}}</td></tr>
{{if .Revoked}}<tr><td style="padding:2px 12px 2px 0;color:#52525b;">Revoked by</td><td style="padding:2px 0;">{{.Actor}} at {{.At}}</td></tr>
<tr><td style="padding:2px 12px 2px 0;color:#52525b;">Revoke reason</td><td style="padding:2px 0;">{{.RevokeReason}}</td></tr>
{{else}}<tr><td style="padding:2px 12px 2px 0;color:#52525b;">Set by</td><td style="padding:2px 0;">{{.Actor}} at {{.At}}</td></tr>
{{end}}</table>
{{end}}
