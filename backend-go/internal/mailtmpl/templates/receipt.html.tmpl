{{define "body"}}
<h1 style="font-size:20px;margin:0 0 4px;">{{.BusinessName}}</h1>
{{range .Header}}<p style="margin:0;color:#52525b;font-size:13px;">{{.}}</p>{{end}}
{{if .Void}}<p style="margin:16px 0;padding:8px 12px;background:#fee2e2;color:#991b1b;font-weight:bold;">This sale was voided. The attached receipt is marked VOID.</p>{{end}}
<p style="margin:16px 0 0;">Hello {{.CustomerName}},</p>
<p style="margin:8px 0 0;">Thank you for your purchase.</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:16px 0;font-size:14px;">
<tr><td style="padding:2px 16px 2px 0;color:#52525b;">Receipt</td><td>{{.Reference}}</td></tr>
<tr><td style="padding:2px 16px 2px 0;color:#52525b;">Date</td><td>{{.Date}}</td></tr>
<tr><td style="padding:2px 16px 2px 0;color:#52525b;">Total</td><td><strong>{{.Total}}</strong></td></tr>
</table>
{{if .Attached}}<p style="margin:0;">Your receipt is attached as a PDF.</p>{{else}}<p style="margin:0;">Your receipt could not be attached. Please ask the store for a copy.</p>{{end}}
<p style="margin:16px 0 0;font-size:13px;color:#52525b;">{{.StoreName}}{{if .StoreAddress}}, {{.StoreAddress}}{{end}}{{if .StorePhone}} · {{.StorePhone}}{{end}}</p>
{{range .Footer}}<p style="margin:4px 0 0;font-size:12px;color:#71717a;">{{.}}</p>{{end}}
{{end}}
