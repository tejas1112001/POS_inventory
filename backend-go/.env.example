# Settings for running posd outside Docker (`go run ./cmd/posd`).
# Copy to .env (git-ignored), fill in, then: set -a; . ./.env; set +a
# Every variable is documented in docs/PHASE1_DESIGN.md §6.
# Generate keys with:  openssl rand -base64 32

APP_ENV=development
PUBLIC_SCHEME=http
BASE_DOMAIN=localhost
PLATFORM_NAME=POS Dev
HTTP_ADDR=:8080
METRICS_ADDR=127.0.0.1:9090
# STATIC_DIR=../frontend/dist-go   # expects tenant/, admin/, landing/ subfolders

DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:55432/pos?sslmode=disable
DATABASE_JOBS_URL=postgres://postgres:CHANGE_ME@localhost:55432/pos?sslmode=disable
# DATABASE_MIGRATOR_URL=          # step 3
# LISTEN_DATABASE_URL=            # defaults to DATABASE_URL; must be a direct endpoint

JWT_KEYS=k1:
PLATFORM_JWT_KEYS=p1:
MASTER_KEYS=m1:

# TRUSTED_PROXY_CIDRS=             # required in production
# CORS_DEV_ORIGINS=http://localhost:5173
# HSTS_ENABLED=false               # turn on after the go-live checklist

LOG_LEVEL=debug
LOG_FORMAT=text
