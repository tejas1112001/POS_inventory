# Development: Caddy's internal CA issues certificates for localhost and
# *.localhost. Production config: TENANCY §7.2.
{
	local_certs
}

localhost, *.localhost {
	tls internal
	request_body {
		max_size 10MB
	}

	@app path /api/* /healthz /health /readyz /files/*
	handle @app {
		reverse_proxy app:8080 {
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle {
		reverse_proxy {$FRONTEND_UPSTREAM} {
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
