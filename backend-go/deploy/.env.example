# Copy to deploy/.env (git-ignored) and replace every value.
# Generate secrets with:  openssl rand -base64 32
# Never reuse a value from this file or from the old backend/.env.

POSTGRES_PASSWORD=
# Login passwords for the app roles (>= 16 chars each).
POS_APP_PASSWORD=
POS_JOBS_PASSWORD=
POS_MIGRATOR_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

BASE_DOMAIN=localhost
PLATFORM_NAME=POS Dev

# kid:base64, first key signs, all verify. At least 32 random bytes each.
JWT_KEYS=
PLATFORM_JWT_KEYS=
# Exactly 32 random bytes each.
MASTER_KEYS=

LOG_LEVEL=debug
LOG_FORMAT=text

# Billing: none, fake (development and tests only) or razorpay.
# Default: fake outside production, none in production.
# BILLING_PROVIDER=razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Webhook signing secret, at least 16 random characters. With the fake
# provider it lets you sign test webhooks yourself.
# RAZORPAY_WEBHOOK_SECRET=
# BILLING_GRACE_DAYS=7
# Deletion clock: read-only or suspended by billing this many days →
# pending_deletion (final export); eligible for deletion after RETENTION_DAYS.
# READ_ONLY_DAYS=30
# RETENTION_DAYS=90

# Tenant exports (off unless both are set). Generate with age-keygen: the
# public key (age1…) goes here; the private key (AGE-SECRET-KEY-1…) is for
# posctl tenant restore only and must never be given to posd.
# EXPORT_AGE_RECIPIENT=
# HMAC key for export manifests, at least 32 random characters.
# EXPORT_MANIFEST_KEY=
# For restores, put EXPORT_AGE_IDENTITY and the same EXPORT_MANIFEST_KEY in
# deploy/.env.restore (git-ignored, never read by posd); make restore-tests-dev
# uses it to run the restore tests queued in the console.
