# Copy to deploy/.env (git-ignored) and replace every value.
# Generate secrets with:  openssl rand -base64 32
# Never reuse a value from this file or from the old backend/.env.

POSTGRES_PASSWORD=
# Login passwords for the app roles (>= 16 chars each).
POS_APP_PASSWORD=
POS_JOBS_PASSWORD=
POS_MIGRATOR_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

BASE_DOMAIN=localhost
PLATFORM_NAME=POS Dev

# kid:base64, first key signs, all verify. At least 32 random bytes each.
JWT_KEYS=
PLATFORM_JWT_KEYS=
# Exactly 32 random bytes each.
MASTER_KEYS=

LOG_LEVEL=debug
LOG_FORMAT=text

# Billing: none, fake (development and tests only) or razorpay.
# Default: fake outside production, none in production.
# BILLING_PROVIDER=razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Webhook signing secret, at least 16 random characters. With the fake
# provider it lets you sign test webhooks yourself.
# RAZORPAY_WEBHOOK_SECRET=
# BILLING_GRACE_DAYS=7
